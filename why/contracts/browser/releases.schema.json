{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release summaries",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["repository", "version", "commit", "sender", "auth_method", "received_at", "evidence"],
    "properties": {
      "repository": { "$ref": "#/$defs/releaseText" },
      "version": { "$ref": "#/$defs/releaseText" },
      "commit": { "type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})(?![\\s\\S])" },
      "sender": { "type": "string", "minLength": 1, "not": { "pattern": "\\u0000" } },
      "auth_method": { "enum": ["api_key", "github_oidc"] },
      "received_at": { "$ref": "attestation.schema.json#/$defs/summary/properties/received_at" },
      "evidence": {
        "type": ["object", "null"],
        "required": ["overall", "completed_rule_sets"],
        "properties": {
          "overall": { "$ref": "attestation.schema.json#/$defs/summary/properties/overall" },
          "completed_rule_sets": {
            "type": "array",
            "items": { "$ref": "completed-rule-sets.schema.json#/items/properties/sets/items" }
          }
        }
      }
    }
  },
  "$defs": {
    "releaseText": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\\u0000" } }
  }
}
