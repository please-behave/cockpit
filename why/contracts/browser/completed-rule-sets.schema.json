{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completed Rule Sets by repository",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["repository", "sets"],
    "properties": {
      "repository": { "$ref": "attestation.schema.json#/$defs/summary/properties/repository" },
      "sets": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["source", "path", "id", "version", "name"],
          "properties": {
            "source": { "type": "string" },
            "path": { "type": "string" },
            "id": { "type": "string" },
            "version": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      }
    }
  }
}
